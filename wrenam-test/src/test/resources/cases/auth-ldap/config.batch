# Create test realm
create-realm --realm auth-ldap

# Configure the LDAP authentication module with the user store connection
update-auth-instance --name LDAP --realm auth-ldap --datafile setup/auth-ldap/LDAP.properties

# Configure ldapService chain to use LDAP module as REQUISITE
update-auth-cfg-entr --name ldapService --realm auth-ldap --entries LDAP|REQUISITE|
