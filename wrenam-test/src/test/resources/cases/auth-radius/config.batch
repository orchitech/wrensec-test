# Create test realm
create-realm --realm auth-radius

# Configure the RADIUS authentication module to use the RADIUS server on the remote Wren:AM
create-auth-instance --name RADIUS --realm auth-radius --authtype RADIUS
update-auth-instance --name RADIUS --realm auth-radius --datafile setup/auth-radius/RADIUS.properties

# Configure ldapService chain to use RADIUS module as REQUISITE
update-auth-cfg-entr --name ldapService --realm auth-radius --entries RADIUS|REQUISITE|
