# Create test realm with the user authenticated over RADIUS
create-realm --realm auth-radius
create-identity --realm /auth-radius --idname john --idtype User --datafile setup/auth-radius/remote/user-john.properties

# Single step chain (RADIUS Access-Request -> Access-Accept / Access-Reject)
create-auth-cfg --name radiusBackend --realm auth-radius
update-auth-cfg-entr --name radiusBackend --realm auth-radius --entries DataStore|REQUISITE|

# Two step chain (second module inputs are requested via RADIUS Access-Challenge)
create-auth-instance --name DataStore2 --realm auth-radius --authtype DataStore
create-auth-cfg --name radiusChallenge --realm auth-radius
update-auth-cfg-entr --name radiusChallenge --realm auth-radius --entries DataStore|REQUISITE| DataStore2|REQUISITE|

# Enable the RADIUS server (applied by the server when RADIUS client configuration changes)
set-attr-defs --servicename RadiusServerService --schematype global --attributevalues radiusListenerEnabled=YES
