# Create test realm
create-realm --realm oauth2

# Configure OAuth2 Provider service
add-svc-realm --realm oauth2 --servicename OAuth2Provider --datafile setup/oauth2/OAuth2Provider.properties

# Create OIDC agent
create-agent --realm oauth2 --agenttype OAuth2Client --agentname test --datafile setup/oauth2/agent-test.properties