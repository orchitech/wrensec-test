# Create test realm
create-realm --realm federation

# Create circle of trust
create-cot --realm /federation --cot test-federation

# Import hosted IdP entity (Wren:AM acting as SAML IdP)
import-entity --realm /federation --meta-data-file setup/federation/local-idp-meta.xml --extended-data-file setup/federation/local/local-idp-extended.xml

# Import hosted SP entity (Wren:AM acting as SAML SP)
import-entity --realm /federation --meta-data-file setup/federation/local-sp-meta.xml --extended-data-file setup/federation/local/local-sp-extended.xml

# Import external IdP entity
import-entity --realm /federation --meta-data-file setup/federation/remote-idp-meta.xml --extended-data-file setup/federation/local/remote-idp-extended.xml

# Import external SP entity
import-entity --realm /federation --meta-data-file setup/federation/remote-sp-meta.xml --extended-data-file setup/federation/local/remote-sp-extended.xml
